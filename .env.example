# Copy this file to .env and fill in your values

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/smartmealdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT (change this to a long random string in production)
JWT_SECRET=SmartMeal2024DesignPatternsSecretKeyMustBe256BitsLong!!
JWT_EXPIRY_MS=86400000

# Google Cloud Vision API
# Get free key at console.cloud.google.com → Enable Cloud Vision API → Create Credentials
# Free tier: 1000 requests/month
# Leave as-is to use demo mode (returns mock labels)
GOOGLE_VISION_API_KEY=YOUR_API_KEY_HERE

# Frontend origin for CORS
CORS_ORIGINS=http://localhost:5173
